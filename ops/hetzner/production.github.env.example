# Paste the reviewed completed content as ONE GitHub production environment secret:
# NIGHTSKY_PRODUCTION_ENV. Replace placeholders privately in GitHub, not here.
# This profile enables only the API sources with confirmed free access and
# migrated quota checkpoints. Do not activate it before migrating those files.
NODE_ENV=production
HOST=0.0.0.0
PORT=5000
NIGHTSKY_DEPLOYMENT_ENV=production
NIGHTSKY_DISCOVERY_MODE=api
NIGHTSKY_MCP_ALLOWED_HOSTS=mcp.nightsky.earth,localhost,127.0.0.1
NIGHTSKY_MCP_TRUSTED_PROXIES=172.30.80.1
NIGHTSKY_PLANNING_CARD_ENABLED=false
NIGHTSKY_LIGHT_POLLUTION_BROWSER_ENABLED=false
NIGHTSKY_LOCATION_USER_AGENT=NightSky.earth/1.0 (nightsky.earth2026@gmail.com)
MET_NORWAY_USER_AGENT=NightSky.earth/1.0 (nightsky.earth2026@gmail.com)
NIGHTSKY_QUOTA_STATE_PATH=/state/provider-quota.json
NIGHTSKY_GEOAPIFY_API_KEY=<replace privately>
NIGHTSKY_WEATHER_PROVIDERS=met
NIGHTSKY_LIGHT_POLLUTION_QUOTA_STATE_PATH=/state/light-pollution-quota.json
NIGHTSKY_LIGHT_POLLUTION_SOURCES=darkskysites
NIGHTSKY_LIGHT_POLLUTION_API_ADMITTED=darkskysites
NIGHTSKY_DARKSKYSITES_API_KEY=<replace privately>
