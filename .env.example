# Environment Variables Example
# Copy this file to .env and fill in your values

# Session Secret (required for authentication)
SESSION_SECRET=your-random-secret-key-here

# Node Environment
NODE_ENV=development

# Database (if using PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/nightsky

# API Keys (if needed)
# Add any third-party API keys here

# Deployment
# NETLIFY_SITE_ID=your-netlify-site-id
# NETLIFY_AUTH_TOKEN=your-netlify-auth-token

# Optional sky-provider credentials. Real values belong only in the private
# C:/Users/TK/.nightsky/providers.env (or deployment secret store), never Git.
# These do not activate requests by themselves.
# NIGHTSKY_NASA_API_KEY=
# NIGHTSKY_ASTRONOMY_API_APP_ID=
# NIGHTSKY_ASTRONOMY_API_APP_SECRET=
# Explicit optional selection; provider admission and persistent quotas also required.
# NIGHTSKY_SKY_PROVIDERS=darkskyplanner,astronomyapi,nasa-donki,jpl
# NIGHTSKY_SKY_ADMITTED_PROVIDERS=
# Separate persistent sky ledger; never use the existing weather ledger path.
# NIGHTSKY_SKY_QUOTA_STATE_PATH=
# Fresh initialization only, after verifying remaining source allowances:
# NIGHTSKY_SKY_QUOTA_VERIFIED_UNUSED_BUDGET=yes
# NIGHTSKY_SKY_QUOTA_VERIFICATION_EVIDENCE=
