# Allowlist the files required by Dockerfile.plugin; exclude operator/private data.
**
!Dockerfile.plugin
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!server/
!server/**
!shared/
!shared/**
!scripts/
!scripts/era5/
!scripts/era5/aggregate.ts
!ops/
!ops/hetzner/
!ops/hetzner/runtime-guard.mjs
!ops/hetzner/probe.mjs
!data/
!data/events/
!data/events/*.json
# Keep private files excluded even if introduced beneath an allowed source tree.
**/.env
**/.env.*
**/*.pem
**/*.key
**/credentials*
**/secrets*
**/private/**
**/raw/**
**/decoded/**
**/*.log
**/.data/**
**/.git/**

# Retained legacy recurring dates have an unresolved source review; no runtime image.
data/events/meteor-showers-v1.json
