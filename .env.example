# Environment Variables Example
# Copy this file to .env and fill in your values

# Session Secret (required for authentication)
SESSION_SECRET=your-random-secret-key-here

# Node Environment
NODE_ENV=development

# Database (if using PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/nightsky

# API Keys (if needed)
# Add any third-party API keys here

# Deployment
# NETLIFY_SITE_ID=your-netlify-site-id
# NETLIFY_AUTH_TOKEN=your-netlify-auth-token

# Website-only listing configuration (public values, never secrets)
VITE_NIGHTSKY_LISTING_PUBLISHED=false
VITE_NIGHTSKY_LISTING_URL=
VITE_NIGHTSKY_CLAUDE_LISTING_URL=
VITE_NIGHTSKY_GEMINI_LISTING_URL=
# Official NightSky listing on Grok. Leave blank until the public destination is supplied.
VITE_NIGHTSKY_GROK_LISTING_URL=

# Setup guide resources: public HTTPS URLs on nightsky.earth or its subdomains.
# Leave blank until the actual resource is verified. No credentials or query tokens.
# The hosted service address must end in /mcp. It is not a local development address.
VITE_NIGHTSKY_MCP_URL=
# Host-specific ZIPs only; publish with verified backend/installation instructions.
VITE_NIGHTSKY_CLAUDE_PACKAGE_URL=
VITE_NIGHTSKY_CODEX_PACKAGE_URL=
